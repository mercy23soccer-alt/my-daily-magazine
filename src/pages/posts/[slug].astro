---
export async function getStaticPaths() {
  const posts = import.meta.glob("../../content/posts/*.md", { eager: true });
  return Object.entries(posts).map(([path, post]: [string, any]) => {
    const slug = path.split("/").pop().replace(".md", "");
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = post;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Issue {post.frontmatter.date} | ZAZZY</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chivo+Mono:wght@500;700&family=Montserrat:ital,wght@0,700;0,800;0,900;1,900&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@500;700&display=swap" rel="stylesheet" />
    
    <style is:inline>
      :root {
        --bg: #f4f3ef;
        --white: #ffffff;
        --navy: #112233;
        --yellow: #ffde00;
        --red: #e63946;
        --teal: #2a9d8f;
        --purple: #6a4c93;
        --sub-text: #5c677d;
        --border-color: #112233;
        --card-bg: #faf9f6;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; background-color: var(--bg); }
      body {
        color: var(--navy);
        font-family: "Noto Sans JP", sans-serif;
        line-height: 1.95;
        padding: 2rem 1rem 4rem;
        -webkit-font-smoothing: antialiased;
      }

      .magazine-page {
        max-width: 900px;
        margin: 0 auto;
        background-color: var(--white);
        border: 2px solid var(--border-color);
        box-shadow: 8px 8px 0px rgba(17, 34, 51, 0.12);
        padding: clamp(1.8rem, 5vw, 4rem);
      }

      .folio-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 0.8rem;
        font-family: "Chivo Mono", monospace;
        font-size: 0.75rem;
        font-weight: 700;
      }
      .nav-link-btn {
        text-decoration: none;
        color: var(--navy);
        border: 1.5px solid var(--border-color);
        padding: 0.2rem 0.6rem;
        background: var(--yellow);
        font-weight: 700;
        transition: 0.1s;
      }
      .nav-link-btn:hover { background: #fff; }

      .masthead {
        text-align: center;
        padding: 2.5rem 0 1.5rem;
        border-bottom: 3px solid var(--border-color);
      }
      .main-logo {
        font-family: "Montserrat", sans-serif;
        font-size: clamp(3rem, 9vw, 5.2rem);
        font-weight: 900;
        font-style: italic;
        line-height: 0.9;
        color: var(--navy);
      }
      .archive-stamp {
        margin-top: 1rem;
        font-family: "Chivo Mono", monospace;
        font-size: 0.82rem;
        font-weight: 800;
        color: var(--red);
      }

      .article-content { margin-top: 2rem; }
      .article-content h2 {
        font-family: "Montserrat", sans-serif;
        font-size: 1.35rem;
        font-weight: 900;
        background: #f5f4ef;
        border-left: 6px solid var(--navy);
        padding: 0.6rem 1rem;
        margin: 3.5rem 0 1.5rem;
      }
      .article-content p {
        margin-bottom: 1.6rem;
        text-align: justify;
        font-size: 0.98rem;
        color: #2b2d42;
      }
      .article-content a {
        color: var(--red);
        text-decoration: none;
        font-weight: 700;
        border-bottom: 2px solid var(--red);
      }
      .magazine-photo-box { margin: 2.5rem 0; }
      .magazine-photo-box img {
        width: 100%;
        height: auto;
        border: 2px solid var(--border-color);
      }
      .photo-caption {
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        color: var(--sub-text);
        margin-top: 0.5rem;
        text-align: right;
      }

      .footer-deck {
        margin-top: 4rem;
        border-top: 2px solid var(--border-color);
        padding-top: 2rem;
        text-align: center;
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        color: var(--sub-text);
      }
    </style>
  </head>
  <body>
    <article class="magazine-page">
      <div class="folio-bar">
        <a href="/my-daily-magazine/archive/" class="nav-link-btn">← 目録（バックナンバー一覧）へ</a>
        <a href="/my-daily-magazine/" class="nav-link-btn">最新号へ戻る ↗</a>
      </div>

      <header class="masthead">
        <h1 class="main-logo">ZAZZY</h1>
        <p class="archive-stamp">ARCHIVE ISSUE // {post.frontmatter.date}</p>
      </header>

      <main class="article-content">
        <Content />
      </main>

      <footer class="footer-deck">
        <p>© 2026 ZAZZY — BACK NUMBER ARCHIVE.</p>
      </footer>
    </article>

    <script is:inline>
      document.querySelectorAll(".article-content a").forEach((link) => {
        if (link.hostname && link.hostname !== window.location.hostname) {
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        }
      });
    </script>
  </body>
</html>
