---
// 生成された記事を読み込む
const posts = import.meta.glob("../content/posts/*.md", { eager: true });
const postList: any[] = Object.values(posts);
postList.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const latest = postList[0];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>THE DAILY EXTRACT</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono&family=Noto+Serif+JP:wght@400;600&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet" />
    <style>
      body { background-color: #eae6db; color: #161616; font-family: "Noto Serif JP", serif; line-height: 1.8; margin: 0; padding: 2rem 1rem; }
      .sheet { max-width: 800px; margin: 0 auto; background-color: #f8f6f0; padding: 3rem 2rem; border: 1px solid #dcd8ce; }
      .meta { display: flex; justify-content: space-between; font-family: "JetBrains Mono", monospace; font-size: 0.8rem; border-bottom: 1px solid #dcd8ce; padding-bottom: 0.5rem; color: #5a5752; }
      .title { font-family: "Playfair Display", serif; font-size: 2.5rem; margin: 1rem 0; border-bottom: 2px solid #161616; padding-bottom: 0.5rem; }
      pre { background-color: #ece8dc; padding: 1rem; overflow-x: auto; font-family: "JetBrains Mono", monospace; }
      h2 { font-family: "Playfair Display", serif; border-top: 1px solid #161616; padding-top: 1rem; margin-top: 2rem; }
    </style>
  </head>
  <body>
    <div class="sheet">
      <div class="meta">
        <span>TOKYO EDITION</span>
        {latest && <span>TEMP: {latest.frontmatter.temp}</span>}
        {latest && <span>SUNSET: {latest.frontmatter.sunset}</span>}
      </div>
      <h1 class="title">THE DAILY EXTRACT</h1>
      {latest ? <latest.Content /> : <p>初号を準備中です。右上のActionsから実行してください。</p>}
    </div>
  </body>
</html>
