---
const posts = import.meta.glob("../content/posts/*.md", { eager: true });
const postList: any[] = Object.values(posts);
postList.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const latest = postList[0];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>THE DAILY EXTRACT | Paternity, Process & Mind</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chivo+Mono:wght@500;700&family=Noto+Serif+JP:wght@400;700&family=Oswald:wght@700&family=Work+Sans:ital,wght@0,800;1,900&display=swap" rel="stylesheet" />
    
    <style is:inline>
      :root {
        --paper: #f8f6f0;
        --desk: #ded8cb;
        --ink: #1a1918;
        --yellow: #fadc41;
        --orange: #e85933;
        --line: #1a1918;
        --gray-box: #ede9df;
        --blue-accent: #2c5282;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; background-color: var(--desk); }
      body {
        color: var(--ink);
        font-family: "Noto Serif JP", serif;
        line-height: 1.95;
        padding: 2.5rem 1rem 4rem;
        -webkit-font-smoothing: antialiased;
      }

      .magazine {
        max-width: 880px;
        margin: 0 auto;
        background-color: var(--paper);
        border: 2px solid var(--line);
        box-shadow: 10px 10px 0px var(--line);
        padding: clamp(1.5rem, 5vw, 3.5rem);
      }

      .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid var(--line);
        padding-bottom: 0.8rem;
        font-family: "Chivo Mono", monospace;
        font-size: 0.75rem;
        font-weight: 700;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .badge-edition {
        background-color: var(--yellow);
        border: 1.5px solid var(--line);
        padding: 0.2rem 0.6rem;
        font-weight: 800;
      }
      .archive-btn {
        text-decoration: none;
        color: var(--ink);
        background: #fff;
        border: 1.5px solid var(--line);
        padding: 0.2rem 0.6rem;
        font-weight: 700;
        box-shadow: 2px 2px 0 var(--line);
      }

      .masthead {
        text-align: center;
        padding: 2.5rem 0 1.8rem;
        border-bottom: 3px double var(--line);
      }
      .tagline {
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        color: var(--orange);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
      }
      .logo {
        font-family: "Work Sans", sans-serif;
        font-size: clamp(2.8rem, 8vw, 5rem);
        font-weight: 900;
        font-style: italic;
        line-height: 0.92;
        letter-spacing: -0.03em;
        text-transform: uppercase;
      }
      .issue-sub {
        margin-top: 1rem;
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        font-family: "Chivo Mono", monospace;
        font-size: 0.78rem;
        font-weight: 700;
        flex-wrap: wrap;
      }

      .quick-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 1.2rem 0;
        border-bottom: 1px dashed rgba(0,0,0,0.15);
      }
      .chip-link {
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        font-weight: 700;
        text-decoration: none;
        color: var(--ink);
        background: var(--gray-box);
        border: 1px solid var(--line);
        padding: 0.3rem 0.6rem;
        transition: 0.1s;
      }
      .chip-link:hover {
        background: var(--yellow);
        transform: translateY(-2px);
        box-shadow: 2px 2px 0 var(--line);
      }

      .radio-panel {
        background: #1a1918;
        color: #fff;
        padding: 0.9rem 1.4rem;
        margin: 1.5rem 0 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 2px solid var(--line);
        box-shadow: 4px 4px 0 var(--line);
        gap: 1rem;
      }
      .radio-btn {
        background: var(--yellow);
        color: var(--ink);
        border: 1px solid #000;
        font-family: "Chivo Mono", monospace;
        font-weight: 800;
        font-size: 0.8rem;
        padding: 0.4rem 1rem;
        cursor: pointer;
        box-shadow: 2px 2px 0 #000;
      }
      .radio-status {
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        color: #bbb;
      }

      .article-body { margin-top: 1.5rem; }
      .article-body h2 {
        font-family: "Oswald", sans-serif;
        font-size: 1.45rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        background: var(--gray-box);
        border-top: 2px solid var(--line);
        border-bottom: 1.5px solid var(--line);
        padding: 0.5rem 0.8rem;
        margin: 3.5rem 0 1.2rem;
        scroll-margin-top: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .article-body h2::before { content: "■"; color: var(--orange); font-size: 0.85rem; }
      .article-body h3 {
        font-family: "Noto Serif JP", serif;
        font-size: 1.15rem;
        font-weight: 700;
        margin: 1.8rem 0 0.6rem;
      }
      .article-body p { margin-bottom: 1.5rem; text-align: justify; font-size: 0.98rem; }

      /* メイリオ指定・視覚的フローチャート */
      .flow-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        margin: 2rem 0;
        padding: 1.5rem;
        background: #ffffff;
        border: 2px solid var(--line);
        box-shadow: 6px 6px 0 var(--line);
        font-family: "Meiryo", "Hiragino Kaku Gothic ProN", sans-serif;
        overflow-x: auto;
      }
      .flow-card {
        flex: 1;
        min-width: 170px;
        background: #fbfaf8;
        border: 1.5px solid #2d3748;
        padding: 0.9rem;
        border-radius: 4px;
        box-shadow: 2px 2px 0 #cbd5e0;
      }
      .flow-step {
        font-size: 0.7rem;
        font-weight: 800;
        background: var(--yellow);
        padding: 0.15rem 0.4rem;
        border: 1px solid #000;
        display: inline-block;
        margin-bottom: 0.4rem;
      }
      .flow-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1a202c;
        margin-bottom: 0.3rem;
      }
      .flow-body {
        font-size: 0.8rem;
        color: #4a5568;
        line-height: 1.45;
      }
      .flow-arrow {
        font-size: 1.4rem;
        font-weight: 900;
        color: var(--orange);
        user-select: none;
      }

      /* 35mmポラロイド風スナップ写真 */
      .article-body img {
        width: 100%;
        max-width: 100%;
        height: auto;
        display: block;
        margin: 2.5rem 0;
        background: #fff;
        padding: 10px 10px 24px 10px;
        border: 2px solid var(--line);
        box-shadow: 6px 6px 0 var(--line);
        filter: contrast(1.03) saturate(1.05);
      }

      /* リンク */
      .article-body a {
        color: var(--orange);
        text-decoration: none;
        font-weight: 700;
        border-bottom: 1.5px solid var(--orange);
        padding-bottom: 1px;
      }
      .article-body a:hover { background: var(--yellow); color: #000; }
      .article-body ul, .article-body ol { margin: 1.2rem 0 1.8rem 1.4rem; }
      .article-body li { margin-bottom: 0.6rem; font-size: 0.96rem; }

      /* インタラクティブ Gemini Console */
      .gemini-console {
        margin-top: 4rem;
        background: #1a1918;
        color: #f7fafc;
        border: 2px solid var(--line);
        box-shadow: 6px 6px 0 var(--line);
        padding: 1.8rem;
        font-family: "Meiryo", sans-serif;
      }
      .console-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #4a5568;
        padding-bottom: 0.8rem;
        margin-bottom: 1.2rem;
      }
      .console-title {
        font-weight: 800;
        color: var(--yellow);
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .console-input-area {
        display: flex;
        gap: 0.6rem;
      }
      .console-input {
        flex: 1;
        padding: 0.7rem 1rem;
        border: 1px solid #718096;
        background: #2d3748;
        color: #fff;
        font-size: 0.9rem;
      }
      .console-btn {
        background: var(--yellow);
        color: #000;
        font-weight: 700;
        border: none;
        padding: 0.7rem 1.4rem;
        cursor: pointer;
      }
      .console-output {
        margin-top: 1rem;
        padding: 1rem;
        background: #2d3748;
        border-left: 3px solid var(--yellow);
        font-size: 0.9rem;
        line-height: 1.7;
        min-height: 60px;
        display: none;
      }

      .colophon {
        margin-top: 4rem;
        border-top: 2px solid var(--line);
        padding-top: 1.8rem;
        text-align: center;
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        color: #777;
      }
      @media (max-width: 600px) {
        .magazine { padding: 1.5rem 1rem; }
        .flow-wrapper { flex-direction: column; align-items: stretch; }
        .flow-arrow { text-align: center; transform: rotate(90deg); margin: 0.3rem 0; }
        .radio-panel { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
      }
    </style>
  </head>
  <body>
    <article class="magazine">
      <div class="top-bar">
        <div>
          <span class="badge-edition">DAILY ISSUE</span>
          <span>TOKYO / {latest ? latest.frontmatter.date : ""}</span>
        </div>
        <div>
          <a href="/my-daily-magazine/archive/" class="archive-btn">📁 ARCHIVE (全号) ↗</a>
        </div>
      </div>

      <header class="masthead">
        <p class="tagline">PATERNITY, CHEMICAL PROCESS & COGNITIVE RESTORATION</p>
        <h1 class="logo">THE DAILY EXTRACT</h1>
        <div class="issue-sub">
          <span>ROLE: PATERNITY LEAVE</span>
          <span>·</span>
          <span>MOTORCYCLE: HONDA GB350</span>
          <span>·</span>
          <span>SUNSET: {latest ? latest.frontmatter.sunset : ""}</span>
        </div>
      </header>

      <nav class="quick-chips">
        <a href="#lead-story" class="chip-link">🧪 論文スキーム</a>
        <a href="#news" class="chip-link">📰 育休・一次ニュース</a>
        <a href="#market" class="chip-link">📈 注目株</a>
        <a href="#benjamin" class="chip-link">🧘 デイリーベンジャミン</a>
        <a href="#gemini-counsel" class="chip-link">🤖 Gemini's Counsel</a>
        <a href="#music" class="chip-link">🎤 音楽/英語</a>
        <a href="#book" class="chip-link">📚 推薦本</a>
        <a href="#escape" class="chip-link">🧖 サウナ/日常</a>
      </nav>

      <div class="radio-panel">
        <div>
          <button id="radio-toggle" class="radio-btn">📻 PLAY MORNING RADIO</button>
        </div>
        <div id="radio-status" class="radio-status">AUDIO SYNTHESIS: READY</div>
      </div>

      <main id="article-content" class="article-body">
        {latest ? (
          <latest.Content />
        ) : (
          <p>記事を準備中です。Actionsから実行してください。</p>
        )}
      </main>

      <!-- 誌面埋め込み Gemini Console -->
      <section class="gemini-console">
        <div class="console-header">
          <div class="console-title">🤖 GEMINI CONCIERGE — 育児・思考の壁打ち</div>
          <span style="font-size: 0.75rem; color: #a0aec0;">CBT & Essential Coaching</span>
        </div>
        <p style="font-size: 0.85rem; color: #cbd5e0; margin-bottom: 0.8rem;">
          育児中の焦燥感、タスク過多、他者への助言過多など、今抱えているモヤモヤを吐き出してください。認知行動療法（脱フュージョン・減算法）の観点で客観的に調律します。
        </p>
        <div class="console-input-area">
          <input type="text" id="console-query" class="console-input" placeholder="例: ToDoが多すぎて焦る、睡眠が足りなくてイライラする..." />
          <button id="console-submit" class="console-btn">調律する</button>
        </div>
        <div id="console-result" class="console-output"></div>
      </section>

      <footer class="colophon">
        <p>© 2026 THE DAILY EXTRACT — AUTONOMOUSLY CURATED FOR KOJIMA MASASHI.</p>
      </footer>
    </article>

    <script is:inline>
      // 1. 外部リンクをすべて自動で別タブ化
      document.querySelectorAll("#article-content a").forEach((link) => {
        if (link.hostname && link.hostname !== window.location.hostname) {
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        }
      });

      // 2. 音声合成（句点分割でブラウザ制限を完全回避）
      function splitTextIntoChunks(text, maxLen = 90) {
        const sentences = text.split(/(?<=[。！？\n])/);
        const chunks = [];
        let current = "";
        for (const s of sentences) {
          if (!s.trim()) continue;
          if ((current + s).length > maxLen) {
            if (current) chunks.push(current.trim());
            current = s;
          } else {
            current += s;
          }
        }
        if (current.trim()) chunks.push(current.trim());
        return chunks;
      }

      const btn = document.getElementById("radio-toggle");
      const status = document.getElementById("radio-status");
      let isPlaying = false;
      let chunks = [];
      let currentIdx = 0;

      function stopRadio() {
        window.speechSynthesis.cancel();
        isPlaying = false;
        btn.innerText = "📻 PLAY MORNING RADIO";
        status.innerText = "AUDIO SYNTHESIS: STOPPED";
      }

      function speakNextChunk() {
        if (!isPlaying) return;
        if (currentIdx >= chunks.length) {
          isPlaying = false;
          btn.innerText = "📻 PLAY MORNING RADIO";
          status.innerText = "AUDIO SYNTHESIS: FINISHED";
          return;
        }

        const utterance = new SpeechSynthesisUtterance(chunks[currentIdx]);
        utterance.lang = "ja-JP";
        utterance.rate = 1.05;

        utterance.onend = () => {
          currentIdx++;
          speakNextChunk();
        };

        utterance.onerror = () => {
          currentIdx++;
          if (currentIdx < chunks.length) speakNextChunk();
          else stopRadio();
        };

        window.speechSynthesis.speak(utterance);
      }

      btn.addEventListener("click", () => {
        if (!("speechSynthesis" in window)) {
          alert("お使いのブラウザは音声読み上げに対応していません。");
          return;
        }

        if (isPlaying) {
          stopRadio();
          return;
        }

        const content = document.getElementById("article-content");
        if (!content) return;

        const rawText = content.innerText
          .replace(/https?:\/\/\S+/g, "")
          .replace(/\[DOI:[^\]]+\]/g, "")
          .replace(/[#*`_■§➔]/g, "")
          .trim();

        chunks = splitTextIntoChunks(rawText, 90);
        if (chunks.length === 0) return;

        window.speechSynthesis.cancel();
        isPlaying = true;
        currentIdx = 0;
        btn.innerText = "⏹ STOP RADIO";
        status.innerText = "BROADCASTING NOW...";

        speakNextChunk();
      });

      // 3. Gemini Console クライアント調律ロジック
      const qInput = document.getElementById("console-query");
      const qSubmit = document.getElementById("console-submit");
      const qResult = document.getElementById("console-result");

      qSubmit.addEventListener("click", () => {
        const text = qInput.value.trim();
        if (!text) return;

        qResult.style.display = "block";
        qResult.innerHTML = "<em>思考を調律中...</em>";

        setTimeout(() => {
          // CBT・脱フュージョン・減算法に基づく即時アンカー処方
          qResult.innerHTML = `
            <strong>【Geminiの調律フィードバック】</strong><br>
            ・<strong>脱フュージョン</strong>: あなたは今、「${text}」という思考を持っています。それは絶対の事実ではなく、脳を通過する一時的な言葉です。<br>
            ・<strong>HALTの点検</strong>: まず睡眠合算7時間、鼻づまり、空腹、身体の緊張を確認してください。思考の焦りは身体疲労の合図です。<br>
            ・<strong>本日の減算法</strong>: 今日の最優先タスクは「家族と生き延びること」のみ。それ以外のToDoは実行キューから削除して横になりましょう。
          `;
        }, 600);
      });
    </script>
  </body>
</html>
