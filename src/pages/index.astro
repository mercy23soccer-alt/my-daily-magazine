---
const posts = import.meta.glob("../content/posts/*.md", { eager: true });
const postList: any[] = Object.values(posts);
postList.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const latest = postList[0];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>THE DAILY EXTRACT | Paternity, Process & Mind</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chivo+Mono:wght@500;700&family=Montserrat:ital,wght@0,700;0,800;0,900;1,900&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@500;700&display=swap" rel="stylesheet" />
    
    <style is:inline>
      :root {
        --bg: #f4f3ef;
        --white: #ffffff;
        --navy: #112233;
        --yellow: #ffde00;
        --red: #e63946;
        --sub-text: #5c677d;
        --border-color: #112233;
        --card-bg: #faf9f6;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; background-color: var(--bg); }
      body {
        color: var(--navy);
        font-family: "Noto Sans JP", sans-serif;
        line-height: 1.95;
        padding: 2rem 1rem 4rem;
        -webkit-font-smoothing: antialiased;
      }

      .magazine-page {
        max-width: 900px;
        margin: 0 auto;
        background-color: var(--white);
        border: 2px solid var(--border-color);
        box-shadow: 8px 8px 0px rgba(17, 34, 51, 0.12);
        padding: clamp(1.8rem, 5vw, 4rem);
      }

      .folio-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 0.8rem;
        font-family: "Chivo Mono", monospace;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .badge-tag {
        background-color: var(--navy);
        color: var(--white);
        padding: 0.2rem 0.6rem;
        font-weight: 800;
        letter-spacing: 0.1em;
      }
      .archive-link {
        color: var(--navy);
        text-decoration: none;
        border: 1.5px solid var(--border-color);
        padding: 0.2rem 0.6rem;
        background: var(--yellow);
        font-weight: 700;
        transition: 0.1s;
      }
      .archive-link:hover { background: #fff; }

      .masthead {
        text-align: center;
        padding: 3rem 0 2rem;
        border-bottom: 3px solid var(--border-color);
      }
      .sub-title {
        font-family: "Montserrat", sans-serif;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.25em;
        color: var(--red);
        margin-bottom: 0.6rem;
        text-transform: uppercase;
      }
      .main-logo {
        font-family: "Montserrat", sans-serif;
        font-size: clamp(3rem, 9vw, 5.5rem);
        font-weight: 900;
        font-style: italic;
        line-height: 0.9;
        letter-spacing: -0.04em;
        color: var(--navy);
        text-transform: uppercase;
      }
      .lead-paternity {
        margin-top: 1.2rem;
        font-family: "Chivo Mono", monospace;
        font-size: 0.8rem;
        font-weight: 700;
        display: flex;
        justify-content: center;
        gap: 1.2rem;
        flex-wrap: wrap;
      }

      .editorial-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 1.2rem 0;
        border-bottom: 1px dashed #ccc;
      }
      .nav-pill {
        font-family: "Montserrat", sans-serif;
        font-size: 0.72rem;
        font-weight: 800;
        text-decoration: none;
        color: var(--navy);
        background: #f0f0eb;
        border: 1.5px solid var(--border-color);
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
        transition: 0.15s;
      }
      .nav-pill:hover, .nav-pill.highlight {
        background: var(--yellow);
        transform: translateY(-2px);
      }
      .nav-pill.highlight { border-color: var(--navy); }

      .radio-bar {
        background: var(--navy);
        color: var(--white);
        padding: 1rem 1.4rem;
        margin: 1.8rem 0 2.8rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 8px;
        box-shadow: 4px 4px 0px rgba(0,0,0,0.15);
        gap: 1rem;
      }
      .radio-btn {
        background: var(--yellow);
        color: var(--navy);
        border: none;
        font-family: "Montserrat", sans-serif;
        font-weight: 800;
        font-size: 0.82rem;
        padding: 0.5rem 1.2rem;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.1s;
      }
      .radio-btn:hover { filter: brightness(1.05); }
      .radio-info {
        font-family: "Chivo Mono", monospace;
        font-size: 0.75rem;
        color: #ccd6f6;
      }

      .article-content { margin-top: 1.5rem; }
      .article-content h2 {
        font-family: "Montserrat", sans-serif;
        font-size: 1.4rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -0.01em;
        background: #f5f4ef;
        border-left: 6px solid var(--navy);
        padding: 0.6rem 1rem;
        margin: 4rem 0 1.5rem;
        scroll-margin-top: 2rem;
      }

      #benjamin {
        background: #fdfaf2 !important;
        border-left: 6px solid var(--red) !important;
        color: var(--navy) !important;
      }

      #comedy {
        background: #f4faf8 !important;
        border-left: 6px solid #2a9d8f !important;
        color: var(--navy) !important;
      }

      .article-content h3 {
        font-family: "Shippori Mincho", serif;
        font-size: 1.18rem;
        font-weight: 700;
        margin: 2rem 0 0.8rem;
        color: var(--navy);
      }
      .article-content p {
        margin-bottom: 1.6rem;
        text-align: justify;
        font-size: 0.98rem;
        color: #2b2d42;
      }

      /* メイリオ視覚的フローチャート */
      .flow-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        margin: 2.2rem 0;
        padding: 1.4rem;
        background: #ffffff;
        border: 2px solid var(--border-color);
        box-shadow: 4px 4px 0px rgba(17, 34, 51, 0.1);
        font-family: "Meiryo", "Hiragino Kaku Gothic ProN", sans-serif;
        overflow-x: auto;
      }
      .flow-card {
        flex: 1;
        min-width: 180px;
        background: var(--card-bg);
        border: 1.5px solid #2d3748;
        padding: 1rem;
        border-radius: 6px;
      }
      .flow-step {
        font-size: 0.72rem;
        font-weight: 800;
        background: var(--yellow);
        padding: 0.15rem 0.5rem;
        border: 1px solid #000;
        display: inline-block;
        margin-bottom: 0.4rem;
        border-radius: 2px;
      }
      .flow-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--navy);
        margin-bottom: 0.3rem;
      }
      .flow-body {
        font-size: 0.82rem;
        color: var(--sub-text);
        line-height: 1.5;
      }
      .flow-arrow {
        font-size: 1.4rem;
        font-weight: 900;
        color: var(--red);
        user-select: none;
      }

      .magazine-photo-box { margin: 3rem 0; }
      .magazine-photo-box img {
        width: 100%;
        height: auto;
        display: block;
        border: 2px solid var(--border-color);
      }
      .photo-caption {
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: var(--sub-text);
        margin-top: 0.5rem;
        text-align: right;
      }

      .article-content a {
        color: var(--red);
        text-decoration: none;
        font-weight: 700;
        border-bottom: 2px solid var(--red);
        padding-bottom: 1px;
        transition: 0.1s;
      }
      .article-content a:hover {
        background: var(--yellow);
        color: #000;
      }
      .article-content ul, .article-content ol { margin: 1.2rem 0 1.8rem 1.4rem; }
      .article-content li { margin-bottom: 0.8rem; font-size: 0.98rem; }

      .gemini-console {
        margin-top: 4.5rem;
        background: #fdfbf7;
        border: 2px solid var(--border-color);
        padding: 2rem;
      }
      .console-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 2px solid var(--border-color);
        padding-bottom: 0.8rem;
        margin-bottom: 1.2rem;
      }
      .console-title {
        font-family: "Montserrat", sans-serif;
        font-weight: 900;
        font-size: 1.1rem;
        color: var(--navy);
      }
      .console-input-area { display: flex; gap: 0.6rem; }
      .console-input {
        flex: 1;
        padding: 0.8rem 1rem;
        border: 1.5px solid var(--border-color);
        background: #fff;
        font-size: 0.92rem;
      }
      .console-btn {
        background: var(--navy);
        color: #fff;
        font-family: "Montserrat", sans-serif;
        font-weight: 800;
        border: none;
        padding: 0.8rem 1.4rem;
        cursor: pointer;
        transition: 0.1s;
      }
      .console-btn:hover { background: var(--red); }
      .console-output {
        margin-top: 1.2rem;
        padding: 1.2rem;
        background: #fff;
        border-left: 4px solid var(--yellow);
        border: 1px solid #e2e8f0;
        border-left-width: 4px;
        font-size: 0.92rem;
        line-height: 1.8;
        display: none;
      }

      .footer-deck {
        margin-top: 5rem;
        border-top: 2px solid var(--border-color);
        padding-top: 2rem;
        text-align: center;
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        color: var(--sub-text);
      }

      @media (max-width: 600px) {
        .magazine-page { padding: 1.5rem 1rem; box-shadow: none; }
        .flow-wrapper { flex-direction: column; align-items: stretch; }
        .flow-arrow { text-align: center; transform: rotate(90deg); margin: 0.2rem 0; }
        .radio-bar { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
      }
    </style>
  </head>
  <body>
    <article class="magazine-page">
      <div class="folio-bar">
        <div>
          <span class="badge-tag">CITY BOY'S JOURNAL</span>
          <span>TOKYO / {latest ? latest.frontmatter.date : ""}</span>
        </div>
        <div>
          <a href="/my-daily-magazine/archive/" class="archive-link">ARCHIVE (全号一覧) ↗</a>
        </div>
      </div>

      <header class="masthead">
        <p class="sub-title">A MAGAZINE FOR CHEMICAL PROCESS, PATERNITY & THE CITY</p>
        <h1 class="main-logo">THE DAILY EXTRACT</h1>
        <div class="lead-paternity">
          <span>SPECIAL: PATERNITY LEAVE</span>
          <span>·</span>
          <span>BIKE: HONDA GB350</span>
          <span>·</span>
          <span>SUNSET: {latest ? latest.frontmatter.sunset : ""}</span>
        </div>
      </header>

      <nav class="editorial-nav">
        <a href="#lead-story" class="nav-pill">01 論文フロー</a>
        <a href="#benjamin" class="nav-pill highlight">★ 02 デイリーベンジャミン</a>
        <a href="#news" class="nav-pill">03 日経・Abema・お笑い</a>
        <a href="#market" class="nav-pill">04 世界経済・注目株</a>
        <a href="#comedy" class="nav-pill highlight">🎭 05 お笑い解体新書</a>
        <a href="#music" class="nav-pill">06 音楽/英語</a>
        <a href="#book" class="nav-pill">07 推薦本</a>
        <a href="#escape" class="nav-pill">08 名銭湯・サウナ</a>
      </nav>

      <div class="radio-bar">
        <div>
          <button id="radio-toggle" class="radio-btn">▶ PLAY MORNING RADIO</button>
        </div>
        <div id="radio-status" class="radio-info">AUDIO SYNTHESIS: READY</div>
      </div>

      <main id="article-content" class="article-content">
        {latest ? (
          <latest.Content />
        ) : (
          <p>最新号を発行中です。Actionsから実行してください。</p>
        )}
      </main>

      <section class="gemini-console">
        <div class="console-header">
          <div class="console-title">🤖 GEMINI CONCIERGE — 育児・思考の壁打ち</div>
          <span style="font-size: 0.75rem; color: var(--sub-text);">CBT & Essential Coaching</span>
        </div>
        <p style="font-size: 0.88rem; color: #4a5568; margin-bottom: 1rem;">
          育児中の焦燥感、タスク過多、他者への助言過多など、今抱えているモヤモヤを吐き出してください。認知行動療法（脱フュージョン・減算法）の観点で客観的に調律します。
        </p>
        <div class="console-input-area">
          <input type="text" id="console-query" class="console-input" placeholder="例: ToDoが多すぎて焦る、睡眠が足りなくてイライラする..." />
          <button id="console-submit" class="console-btn">調律する</button>
        </div>
        <div id="console-result" class="console-output"></div>
      </section>

      <footer class="footer-deck">
        <p>© 2026 THE DAILY EXTRACT — PRINTED DIGITALLY FOR PRIVATE USE.</p>
      </footer>
    </article>

    <script is:inline>
      document.querySelectorAll("#article-content a").forEach((link) => {
        if (link.hostname && link.hostname !== window.location.hostname) {
          link.target = "_blank";
          link.rel = "noopener noreferrer";
        }
      });

      function splitTextIntoChunks(text, maxLen = 90) {
        const sentences = text.split(/(?<=[。！？\n])/);
        const chunks = [];
        let current = "";
        for (const s of sentences) {
          if (!s.trim()) continue;
          if ((current + s).length > maxLen) {
            if (current) chunks.push(current.trim());
            current = s;
          } else {
            current += s;
          }
        }
        if (current.trim()) chunks.push(current.trim());
        return chunks;
      }

      const btn = document.getElementById("radio-toggle");
      const status = document.getElementById("radio-status");
      let isPlaying = false;
      let chunks = [];
      let currentIdx = 0;

      function stopRadio() {
        window.speechSynthesis.cancel();
        isPlaying = false;
        btn.innerText = "▶ PLAY MORNING RADIO";
        status.innerText = "AUDIO SYNTHESIS: STOPPED";
      }

      function speakNextChunk() {
        if (!isPlaying) return;
        if (currentIdx >= chunks.length) {
          isPlaying = false;
          btn.innerText = "▶ PLAY MORNING RADIO";
          status.innerText = "AUDIO SYNTHESIS: FINISHED";
          return;
        }

        const utterance = new SpeechSynthesisUtterance(chunks[currentIdx]);
        utterance.lang = "ja-JP";
        utterance.rate = 1.05;

        utterance.onend = () => {
          currentIdx++;
          speakNextChunk();
        };

        utterance.onerror = () => {
          currentIdx++;
          if (currentIdx < chunks.length) speakNextChunk();
          else stopRadio();
        };

        window.speechSynthesis.speak(utterance);
      }

      btn.addEventListener("click", () => {
        if (!("speechSynthesis" in window)) {
          alert("お使いのブラウザは音声読み上げに対応していません。");
          return;
        }

        if (isPlaying) {
          stopRadio();
          return;
        }

        const content = document.getElementById("article-content");
        if (!content) return;

        const rawText = content.innerText
          .replace(/https?:\/\/\S+/g, "")
          .replace(/\[DOI:[^\]]+\]/g, "")
          .replace(/[#*`_■§➔▲★🎭]/g, "")
          .trim();

        chunks = splitTextIntoChunks(rawText, 90);
        if (chunks.length === 0) return;

        window.speechSynthesis.cancel();
        isPlaying = true;
        currentIdx = 0;
        btn.innerText = "⏹ STOP RADIO";
        status.innerText = "ON AIR : READING MORNING ISSUE";

        speakNextChunk();
      });

      const qInput = document.getElementById("console-query");
      const qSubmit = document.getElementById("console-submit");
      const qResult = document.getElementById("console-result");

      qSubmit.addEventListener("click", () => {
        const text = qInput.value.trim();
        if (!text) return;

        qResult.style.display = "block";
        qResult.innerHTML = "<em>思考を調律中...</em>";

        setTimeout(() => {
          qResult.innerHTML = `
            <strong>【Geminiの調律フィードバック】</strong><br>
            ・<strong>脱フュージョン</strong>: あなたは今、「${text}」という思考を持っています。それは絶対の事実ではなく、頭を通過する言葉です。<br>
            ・<strong>HALTの点検</strong>: まず睡眠合算7時間、鼻づまり、空腹、身体の緊張を確認してください。思考の焦りは身体疲労の合図です。<br>
            ・<strong>本日の減算法</strong>: 今日の最優先タスクは「家族と生き延びること」のみ。それ以外のToDoは実行キューから削除して横になりましょう。
          `;
        }, 500);
      });
    </script>
  </body>
</html>
