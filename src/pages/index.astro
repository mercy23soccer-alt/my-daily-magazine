---
const posts = import.meta.glob("../content/posts/*.md", { eager: true });
const postList: any[] = Object.values(posts);
postList.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const latest = postList[0];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>THE DAILY EXTRACT | Magazine for City Boys</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chivo+Mono:wght@500;700&family=Noto+Serif+JP:wght@400;700&family=Oswald:wght@700&family=Work+Sans:ital,wght@0,800;1,900&display=swap" rel="stylesheet" />
    
    <!-- is:inline を指定してデザインの読み込みエラーを完全に防止 -->
    <style is:inline>
      :root {
        --paper: #f8f6f0;
        --desk: #ded8cb;
        --ink: #1a1918;
        --yellow: #fadc41;
        --orange: #e85933;
        --line: #1a1918;
        --gray-box: #ede9df;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; background-color: var(--desk); }
      body {
        color: var(--ink);
        font-family: "Noto Serif JP", serif;
        line-height: 1.9;
        padding: 2.5rem 1rem 4rem;
        -webkit-font-smoothing: antialiased;
      }

      /* 雑誌の紙面コンテナ */
      .magazine {
        max-width: 860px;
        margin: 0 auto;
        background-color: var(--paper);
        border: 2px solid var(--line);
        box-shadow: 10px 10px 0px var(--line);
        padding: clamp(1.5rem, 5vw, 3.5rem);
      }

      /* 最上部のヘッダーバー */
      .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid var(--line);
        padding-bottom: 0.8rem;
        font-family: "Chivo Mono", monospace;
        font-size: 0.75rem;
        font-weight: 700;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .badge-edition {
        background-color: var(--yellow);
        border: 1.5px solid var(--line);
        padding: 0.2rem 0.6rem;
        font-weight: 800;
        letter-spacing: 0.05em;
      }
      .archive-btn {
        text-decoration: none;
        color: var(--ink);
        background: #fff;
        border: 1.5px solid var(--line);
        padding: 0.2rem 0.6rem;
        font-weight: 700;
        box-shadow: 2px 2px 0 var(--line);
        transition: 0.1s;
      }
      .archive-btn:hover {
        background: var(--yellow);
        transform: translate(-1px, -1px);
        box-shadow: 3px 3px 0 var(--line);
      }

      /* マストヘッド（雑誌タイトル） */
      .masthead {
        text-align: center;
        padding: 2.5rem 0 1.8rem;
        border-bottom: 3px double var(--line);
      }
      .tagline {
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        color: var(--orange);
        margin-bottom: 0.5rem;
        text-transform: uppercase;
      }
      .logo {
        font-family: "Work Sans", sans-serif;
        font-size: clamp(2.8rem, 8vw, 5rem);
        font-weight: 900;
        font-style: italic;
        line-height: 0.92;
        letter-spacing: -0.03em;
        text-transform: uppercase;
      }
      .issue-sub {
        margin-top: 1rem;
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        font-family: "Chivo Mono", monospace;
        font-size: 0.78rem;
        font-weight: 700;
      }

      /* クイック目次タグ */
      .quick-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 1.2rem 0;
        border-bottom: 1px dashed rgba(0,0,0,0.15);
      }
      .chip-link {
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        font-weight: 700;
        text-decoration: none;
        color: var(--ink);
        background: var(--gray-box);
        border: 1px solid var(--line);
        padding: 0.3rem 0.6rem;
        transition: 0.1s;
      }
      .chip-link:hover {
        background: var(--yellow);
        transform: translateY(-2px);
        box-shadow: 2px 2px 0 var(--line);
      }

      /* モーニングラジオ（オーディオデッキ風） */
      .radio-panel {
        background: #1a1918;
        color: #fff;
        padding: 0.9rem 1.4rem;
        margin: 1.5rem 0 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 2px solid var(--line);
        box-shadow: 4px 4px 0 var(--line);
        gap: 1rem;
      }
      .radio-btn {
        background: var(--yellow);
        color: var(--ink);
        border: 1px solid #000;
        font-family: "Chivo Mono", monospace;
        font-weight: 800;
        font-size: 0.8rem;
        padding: 0.4rem 1rem;
        cursor: pointer;
        box-shadow: 2px 2px 0 #000;
      }
      .radio-status {
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        color: #bbb;
      }

      /* 記事本文のデザイン */
      .article-body {
        margin-top: 1.5rem;
      }
      .article-body h2 {
        font-family: "Oswald", sans-serif;
        font-size: 1.45rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        background: var(--gray-box);
        border-top: 2px solid var(--line);
        border-bottom: 1.5px solid var(--line);
        padding: 0.5rem 0.8rem;
        margin: 3.5rem 0 1.2rem;
        scroll-margin-top: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .article-body h2::before {
        content: "■";
        color: var(--orange);
        font-size: 0.85rem;
      }
      .article-body h3 {
        font-family: "Noto Serif JP", serif;
        font-size: 1.15rem;
        font-weight: 700;
        margin: 1.8rem 0 0.6rem;
      }
      .article-body p {
        margin-bottom: 1.5rem;
        text-align: justify;
        font-size: 0.96rem;
      }

      /* 35mmスナップ写真（ポラロイド風額装） */
      .article-body img {
        width: 100%;
        max-width: 100%;
        height: auto;
        display: block;
        margin: 2.5rem 0;
        background: #fff;
        padding: 10px 10px 24px 10px; /* ポラロイド風の余白 */
        border: 2px solid var(--line);
        box-shadow: 6px 6px 0 var(--line);
        filter: contrast(1.03) saturate(1.05);
      }

      /* 化学反応式・コード枠（ラボの黒板風） */
      .article-body pre {
        background: #1c1d1f;
        color: #f0f0f0;
        padding: 1.4rem;
        border: 2px solid var(--line);
        box-shadow: 4px 4px 0 var(--line);
        overflow-x: auto;
        font-family: "Chivo Mono", monospace;
        font-size: 0.84rem;
        line-height: 1.5;
        margin: 1.8rem 0;
      }

      /* リンク（オレンジのアンダーライン） */
      .article-body a {
        color: var(--orange);
        text-decoration: none;
        font-weight: 700;
        border-bottom: 1.5px solid var(--orange);
        padding-bottom: 1px;
      }
      .article-body a:hover {
        background: var(--yellow);
        color: #000;
      }

      .article-body ul, .article-body ol {
        margin: 1.2rem 0 1.8rem 1.4rem;
      }
      .article-body li {
        margin-bottom: 0.6rem;
        font-size: 0.95rem;
      }

      /* フッター奥付 */
      .colophon {
        margin-top: 4.5rem;
        border-top: 2px solid var(--line);
        padding-top: 1.8rem;
        text-align: center;
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        color: #777;
      }
      @media (max-width: 600px) {
        .magazine { padding: 1.5rem 1rem; box-shadow: none; }
        .radio-panel { flex-direction: column; align-items: flex-start; gap: 0.6rem; }
      }
    </style>
  </head>
  <body>
    <article class="magazine">
      <!-- Top Meta -->
      <div class="top-bar">
        <div>
          <span class="badge-edition">DAILY ISSUE</span>
          <span>TOKYO / {latest ? latest.frontmatter.date : ""}</span>
        </div>
        <div>
          <a href="/my-daily-magazine/archive/" class="archive-btn">📁 ARCHIVE (全号) ↗</a>
        </div>
      </div>

      <!-- Masthead -->
      <header class="masthead">
        <p class="tagline">CHEMICAL PROCESS, HIP-HOP CIPHER & THE CITY ESCAPE</p>
        <h1 class="logo">THE DAILY EXTRACT</h1>
        <div class="issue-sub">
          <span>RIDER: HONDA GB350</span>
          <span>·</span>
          <span>TEMP: {latest ? latest.frontmatter.temp : ""}</span>
          <span>·</span>
          <span>SUNSET: {latest ? latest.frontmatter.sunset : ""}</span>
        </div>
      </header>

      <!-- Quick Jump Navigation -->
      <nav class="quick-chips">
        <a href="#lead-story" class="chip-link">🧪 論文スキーム</a>
        <a href="#news" class="chip-link">📰 ニュース5選</a>
        <a href="#market" class="chip-link">📈 注目株</a>
        <a href="#music" class="chip-link">🎤 音楽/英語</a>
        <a href="#book" class="chip-link">📚 推薦本</a>
        <a href="#curiosity" class="chip-link">🧭 越境コラム</a>
        <a href="#escape" class="chip-link">🧖 サウナ/日常</a>
      </nav>

      <!-- Morning Radio Panel -->
      <div class="radio-panel">
        <div>
          <button id="radio-toggle" class="radio-btn">📻 PLAY MORNING RADIO</button>
        </div>
        <div id="radio-status" class="radio-status">AUDIO SYNTHESIS: READY</div>
      </div>

      <!-- Main Contents -->
      <main id="article-content" class="article-body">
        {latest ? (
          <latest.Content />
        ) : (
          <p>記事を準備中です。Actionsから実行してください。</p>
        )}
      </main>

      <!-- Footer Colophon -->
      <footer class="colophon">
        <p>© 2026 THE DAILY EXTRACT — PRINTED DIGITALLY FOR PRIVATE USE.</p>
      </footer>
    </article>

    <!-- Speech Synthesis Script -->
    <script is:inline>
      const btn = document.getElementById("radio-toggle");
      const status = document.getElementById("radio-status");
      let isPlaying = false;
      let utterance = null;

      btn.addEventListener("click", () => {
        if (!("speechSynthesis" in window)) {
          alert("お使いのブラウザは音声読み上げに対応していません。");
          return;
        }

        if (isPlaying) {
          window.speechSynthesis.cancel();
          isPlaying = false;
          btn.innerText = "📻 PLAY MORNING RADIO";
          status.innerText = "AUDIO SYNTHESIS: STOPPED";
          return;
        }

        const content = document.getElementById("article-content");
        if (!content) return;

        const textToRead = content.innerText
          .replace(/https?:\/\/\S+/g, "")
          .replace(/\[DOI:[^\]]+\]/g, "")
          .substring(0, 4000);

        utterance = new SpeechSynthesisUtterance(textToRead);
        utterance.lang = "ja-JP";
        utterance.rate = 1.05;

        utterance.onend = () => {
          isPlaying = false;
          btn.innerText = "📻 PLAY MORNING RADIO";
          status.innerText = "AUDIO SYNTHESIS: FINISHED";
        };

        utterance.onerror = () => {
          isPlaying = false;
          btn.innerText = "📻 PLAY MORNING RADIO";
          status.innerText = "AUDIO SYNTHESIS: ERROR";
        };

        window.speechSynthesis.speak(utterance);
        isPlaying = true;
        btn.innerText = "⏹ STOP RADIO";
        status.innerText = "BROADCASTING NOW...";
      });
    </script>
  </body>
</html>
