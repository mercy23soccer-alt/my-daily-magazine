---
const posts = import.meta.glob("../content/posts/*.md", { eager: true });
const postList: any[] = Object.values(posts);
postList.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

const latest = postList[0];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>THE DAILY EXTRACT | For City Boys</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chivo+Mono:wght@500;700&family=Noto+Serif+JP:wght@400;700&family=Oswald:wght@700&family=Work+Sans:ital,wght@0,800;1,900&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --paper: #f5f2eb;
        --ink: #111111;
        --yellow: #f8d12e;
        --orange: #e85d3f;
        --gray: #6e6b66;
        --border: #1a1a1a;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background-color: #dfdbd0;
        color: var(--ink);
        font-family: "Noto Serif JP", serif;
        line-height: 1.85;
        padding: 2rem 1rem;
      }
      .magazine-wrapper {
        max-width: 860px;
        margin: 0 auto;
        background-color: var(--paper);
        border: 2px solid var(--border);
        box-shadow: 8px 8px 0px var(--border);
        padding: 2.5rem;
      }
      /* Top Bar */
      .top-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 2px solid var(--border);
        padding-bottom: 0.8rem;
        font-family: "Chivo Mono", monospace;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
      }
      .badge {
        background-color: var(--yellow);
        padding: 0.2rem 0.6rem;
        border: 1px solid var(--border);
        font-weight: bold;
      }
      /* Masthead */
      .masthead {
        text-align: center;
        padding: 2rem 0 1.5rem;
        border-bottom: 3px double var(--border);
      }
      .tagline {
        font-family: "Chivo Mono", monospace;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        color: var(--orange);
        font-weight: 700;
        margin-bottom: 0.3rem;
      }
      .logo {
        font-family: "Work Sans", sans-serif;
        font-size: clamp(2.3rem, 6.5vw, 4rem);
        font-weight: 900;
        font-style: italic;
        letter-spacing: -0.04em;
        line-height: 0.95;
        text-transform: uppercase;
      }
      .issue-sub {
        margin-top: 0.8rem;
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        font-family: "Chivo Mono", monospace;
        font-size: 0.8rem;
        font-weight: 700;
      }
      /* Article Content */
      .article-body {
        font-size: 1rem;
        margin-top: 2rem;
      }
      .article-body h2, .article-body h3 {
        font-family: "Oswald", sans-serif;
        font-size: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        border-top: 2px solid var(--border);
        border-bottom: 1px solid var(--border);
        padding: 0.4rem 0.6rem;
        margin: 3rem 0 1.2rem;
        background-color: #ece8dc;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .article-body h2::before, .article-body h3::before {
        content: "■";
        color: var(--orange);
        font-size: 0.85rem;
      }
      .article-body h4 {
        font-family: "Noto Serif JP", serif;
        font-size: 1.15rem;
        font-weight: 700;
        margin: 1.2rem 0 0.6rem;
      }
      .article-body p {
        margin-bottom: 1.4rem;
        text-align: justify;
      }
      /* 35mm Snapshot Styling */
      .article-body img {
        width: 100%;
        max-width: 100%;
        height: auto;
        display: block;
        margin: 2.2rem 0;
        border: 2px solid var(--border);
        box-shadow: 6px 6px 0px var(--border);
        filter: contrast(1.04) saturate(1.05);
      }
      .article-body ul, .article-body ol {
        margin: 1rem 0 1.5rem 1.5rem;
      }
      .article-body li {
        margin-bottom: 0.6rem;
      }
      /* Scheme & Box */
      .article-body pre {
        background-color: #1e1e1e;
        color: #e6e6e6;
        padding: 1.2rem;
        border: 2px solid var(--border);
        overflow-x: auto;
        font-family: "Chivo Mono", monospace;
        font-size: 0.85rem;
        margin: 1.5rem 0;
      }
      .article-body a {
        color: var(--orange);
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .colophon {
        margin-top: 4rem;
        border-top: 2px solid var(--border);
        padding-top: 1.5rem;
        text-align: center;
        font-family: "Chivo Mono", monospace;
        font-size: 0.75rem;
        color: var(--gray);
      }
      @media (max-width: 600px) {
        .magazine-wrapper { padding: 1.5rem 1rem; border-width: 1px; box-shadow: none; }
      }
    </style>
  </head>
  <body>
    <div class="magazine-wrapper">
      <div class="top-meta">
        <div><span class="badge">DAILY ISSUE</span> TOKYO / {latest ? latest.frontmatter.date : ""}</div>
        <div>
          {latest && <span>{latest.frontmatter.temp} · {latest.frontmatter.wind}</span>}
        </div>
      </div>

      <header class="masthead">
        <p class="tagline">CHEMICAL PROCESS, HIP-HOP CIPHER & THE CITY ESCAPE</p>
        <h1 class="logo">THE DAILY EXTRACT</h1>
        <div class="issue-sub">
          <span>RIDER: HONDA GB350</span>
          <span>·</span>
          <span>SUNSET: {latest ? latest.frontmatter.sunset : ""}</span>
        </div>
      </header>

      <main class="article-body">
        {latest ? (
          <latest.Content />
        ) : (
          <p>記事を準備中です。Actionsから実行してください。</p>
        )}
      </main>

      <footer class="colophon">
        <p>© 2026 THE DAILY EXTRACT — AUTONOMOUSLY CURATED FOR PRIVATE USE.</p>
      </footer>
    </div>
  </body>
</html>
